/**
 * Wrangler configuration for the DalyHub V2 Cloudflare Worker.
 * Reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * This file contains no secrets and no real production identifiers. The
 * TOP-LEVEL configuration is the LOCAL / development environment: it uses
 * clearly non-production placeholder values and is what `wrangler dev`, the
 * Workers-runtime tests and the credential-free `deploy:dry-run` use.
 *
 * The named `env.production` environment carries only the non-secret production
 * SWITCHES (`ENVIRONMENT=production`, `AUTH_MODE=cloudflare-access`) plus a
 * deliberately non-functional PLACEHOLDER D1 id. Every real production value —
 * the provisioned D1 database id, the provisioned workspace id, the Access team
 * domain / AUD / owner email — is supplied at deploy time (env vars + `wrangler
 * secret`), never committed. A production deploy runs through
 * `scripts/deploy-production.mjs`, which FAILS before any upload if those real
 * values have not been supplied, so production can never silently ship a local
 * placeholder. See docs/development/DEPLOYMENT.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalyhub-v2",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // LOCAL / development values only (non-secret, safe to expose). The named
  // `env.production` environment below overrides the ones that must differ in
  // production. Bindings and `vars` are NOT inherited by named environments, so
  // production redeclares the ones it needs explicitly.
  "vars": {
    "ENVIRONMENT": "development",
    // FND-03: the server-side workspace scope resolved at the composition
    // boundary (ADR-010). This is trusted server-side CONFIGURATION, not a
    // secret and NOT a request value — it can never be selected via a header,
    // cookie, query string, route param, form field or JSON body. The value
    // below is a clearly non-production LOCAL placeholder; production supplies
    // the real provisioned workspace id at deploy time (see
    // docs/development/DEPLOYMENT.md and docs/development/DATA_KERNEL.md). No
    // personal or production id is committed.
    "DEFAULT_WORKSPACE_ID": "local-dev-workspace",
    // FND-09 authentication (ADR-016). `AUTH_MODE` is the only committed auth
    // value: it is a non-secret default pinning the secure Cloudflare Access mode
    // in production. It FAILS CLOSED — with no Access team domain / AUD / owner
    // configured, the Worker rejects every protected request (503) rather than
    // letting anyone in. Those three values, being private operational config,
    // are supplied ONLY at deploy time via `wrangler secret` / dashboard bindings
    // and are deliberately NOT declared as `vars` here: a committed (even empty)
    // `var` of the same name would OVERRIDE the deploy-time secret and clobber it.
    // The auth configuration reads them as optional (`AuthConfigEnv`), so they
    // need not appear in the generated `Env` type. Local development supplies
    // `AUTH_MODE=development` + `DEV_AUTH_*` through `.dev.vars`, gated so
    // development auth can never activate under a non-development ENVIRONMENT.
    // No personal email, real team domain or AUD tag is committed. See
    // docs/development/APP_SHELL_AUTH.md.
    "AUTH_MODE": "cloudflare-access",
  },
  // D1 (SQLite) is the data kernel's initial relational store (ADR-009 / FND-02).
  // Local development and the Workers Vitest integration use Miniflare's local
  // SQLite keyed by the binding name and do NOT need Cloudflare credentials or a
  // remote database. `database_id` below is an explicit, non-functional LOCAL
  // PLACEHOLDER — no remote D1 database is used for local work. Production uses the
  // real provisioned id supplied at deploy time (see `env.production` and
  // docs/development/DATA_KERNEL.md). Migrations live in ./migrations and are
  // applied with `pnpm run db:migrate:local` locally; production migrations are
  // documented in docs/development/DEPLOYMENT.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalyhub-v2",
      "database_id": "local-development-placeholder-not-provisioned",
      "migrations_dir": "migrations",
    },
  ],
  // V2.11 FILE-00 (ADR-119 decision 3): the private ATTACHMENT bucket -- the
  // owner's live evidence, bound to the APPLICATION Worker because DalyHub owns
  // every read and write path to it. There is no public bucket, no public object
  // URL and no signed URL: every byte leaves through an authenticated route that
  // re-derives the object key from a row it just read under a workspace
  // predicate.
  //
  // This is NOT the backups bucket, and the two stay separate on purpose. The
  // `env.production` comment below says the application Worker deliberately has
  // no R2 binding and no D1-export token: that statement is about
  // `dalyhub-v2-backups` and the token that protects it, and its reason -- a
  // Worker that serves the owner's requests must not hold the credential that
  // guards the recovery copies -- is untouched by binding a DIFFERENT bucket
  // holding the live data those copies are of. One bucket for both would put the
  // data and its backups in one blast radius, which is the argument BACKUP-01
  // made for a separate Worker, applied to storage.
  //
  // Local development and the Workers Vitest integration use Miniflare's local,
  // isolated object storage keyed by the binding name and need NO Cloudflare
  // credentials and no remote bucket. `bucket_name` below is a clearly
  // non-production LOCAL placeholder; production redeclares it in
  // `env.production` with the real provisioned name (bindings are not inherited
  // by named environments). See docs/development/ATTACHMENTS.md for the one
  // owner action this needs: creating the bucket.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "dalyhub-v2-attachments-local",
    },
  ],
  // CAL-01: the external calendar refresh runs on the Worker's own Cron Trigger
  // -- the same Worker, the same D1 binding, no new service to provision. Every
  // 15 minutes is a deliberate bound on cost and on how hard DalyHub polls
  // someone else's calendar server; the product says plainly that this is not
  // realtime synchronisation. The handler is INERT unless the owner has added a
  // calendar source, so a deployment that never uses the feature does no work.
  //
  // `wrangler dev` does not fire crons automatically; use
  // `curl "http://localhost:5173/cdn-cgi/handler/scheduled"` to run one on
  // demand, and Settings -> Calendars -> "Refresh now" for the ordinary path.
  // Tests never depend on the trigger: they call the handler directly.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  // Named production environment (selected at build/deploy time with
  // `CLOUDFLARE_ENV=production`, driven by `pnpm run deploy:production`). It
  // commits ONLY the non-secret production switches and a placeholder D1 id.
  // `scripts/deploy-production.mjs` injects the real provisioned D1 id and
  // workspace id from the environment and refuses to upload while a placeholder
  // remains, so no real private value is committed and no placeholder is ever
  // silently shipped.
  "env": {
    "production": {
      // Permanently disable the alternate public origins for the named production
      // environment. Cloudflare Access protects only the dashboard-managed Custom
      // Domain (hub.daly.id.au); the default `*.workers.dev` route and Cloudflare
      // Preview URLs would be UNPROTECTED origins that reach the Worker without an
      // Access token, so they are turned off here. The Cloudflare Vite build
      // flattens these into build/server/wrangler.json (verified by the deploy
      // guard and its tests), and `scripts/deploy-production.mjs` refuses to upload
      // if either is not `false`. These belong to the named production environment
      // only — local development (top-level config) keeps Wrangler's defaults so
      // `wrangler dev` and the credential-free dry-run work normally. No Worker
      // route or Custom Domain is declared here: the Custom Domain is managed
      // through the Cloudflare dashboard and must not be added/removed by Wrangler.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        // Production is ALWAYS production: this gates off development auth (the
        // development authenticator requires ENVIRONMENT development/test) and
        // forces the `Secure` theme cookie.
        "ENVIRONMENT": "production",
        // Production ALWAYS uses the secure Cloudflare Access authenticator.
        // Never "development": development auth cannot activate in production.
        "AUTH_MODE": "cloudflare-access",
        // DEFAULT_WORKSPACE_ID is intentionally omitted here — the real
        // provisioned workspace id is injected at deploy time, never committed.
      },
      // Bindings and triggers are NOT inherited by named environments, so the
      // production environment redeclares the CAL-01 cron explicitly. Without
      // this line production would deploy with no calendar refresh at all.
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dalyhub-v2",
          // Placeholder ONLY. `scripts/deploy-production.mjs` replaces this with
          // the real provisioned id (`CLOUDFLARE_D1_DATABASE_ID`) in the generated
          // deploy config and fails before upload if it is still a placeholder.
          "database_id": "PLACEHOLDER_SET_REAL_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      // V2.11 FILE-00: the production attachment bucket. Bindings are not
      // inherited by named environments, which is why this is redeclared rather
      // than assumed. The name is NOT a secret -- it is an R2 bucket name in the
      // owner's own account, with no public development URL and no custom
      // domain, exactly like `dalyhub-v2-backups` in infra/backup/wrangler.jsonc
      // -- so it is committed rather than injected at deploy time. What IS
      // private (the account id, the access keys) was never here.
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "dalyhub-v2-attachments",
        },
      ],
      // BACKUP-02: the Worker service binding that lets Settings → Backups show
      // backup health WITHOUT this Worker gaining access to the backups.
      //
      // The application Worker deliberately has NO binding to the BACKUPS bucket
      // and NO D1-export token. (It does bind its own private ATTACHMENTS bucket
      // above -- V2.11, ADR-119 decision 3 -- which is the owner's live evidence
      // rather than the recovery copies of it. The prohibition here is about the
      // credential that guards the backups, and it is unchanged.)
      // It calls the `BackupService` entrypoint on `dalyhub-v2-backup`,
      // which returns sanitised metadata — health, timestamps, sizes, retention —
      // and nothing else. `BackupService` is a NAMED entrypoint rather than a
      // fetch handler, so there is no URL that reaches it: the backup Worker keeps
      // `workers_dev: false`, no route and no custom domain, and remains
      // unreachable from the internet. See infra/backup/src/backup-service.ts.
      //
      // PRODUCTION ONLY, on purpose. A service binding names a deployed Worker,
      // and local development has none — so the binding is absent from the
      // top-level (local) config, `wrangler dev` and the credential-free dry-run
      // work unchanged, and the application reads it through an OPTIONAL config
      // shape whose absence renders as "backup status unavailable". Service
      // bindings are not inherited by named environments, which is why this is
      // declared here rather than above.
      "services": [
        {
          "binding": "BACKUP_SERVICE",
          "service": "dalyhub-v2-backup",
          "entrypoint": "BackupService",
        },
      ],
    },
  },
}
