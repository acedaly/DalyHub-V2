# Dependencies
/node_modules/

# Build output
/build/
*.tsbuildinfo

# React Router generated types
/.react-router/

# Test artefacts
/coverage/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Measurement output: a machine-readable run summary written outside the HTML
# report directory (`PLAYWRIGHT_JSON_OUTPUT_NAME`), and the browser RSS samples
# `scripts/measure-e2e-browser-rss.mjs` collects. Both are EVIDENCE for a
# specific investigation, cited in the audit that used them — they are not
# checked in, for the same reason #158 took the screenshot dumps back out.
/rss-evidence/
/*-results.json

# Screenshot evidence from the opt-in capture passes. Every `*-screenshots.spec`
# writes under `docs/design/assets/<pass>/`, and those dumps are EVIDENCE for a
# specific audit — cited in the record that used them, looked at by whoever ran
# the pass, and not checked in. Same reason #158 took the earlier dumps back
# out, and the same reason the RSS samples above are ignored.
/docs/design/assets/
/docs/product/assets/

# Cloudflare / Wrangler local state and generated types
.mf
.wrangler
worker-configuration.d.ts

# Local environment / secrets — never commit these
.env
.dev.vars
.dev.vars.*
!.dev.vars.example
!.env.example

# OS / editor cruft
.DS_Store
*.log

# Claude Code local worktree/session state
/.claude/

# Scratch Playwright config for the opt-in screenshot passes: the DEV server
# alone, reusing one that is already running. Not part of the gate —
# `playwright.config.ts` is.
scratch.playwright.config.ts
