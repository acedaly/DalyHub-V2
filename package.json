{
  "name": "dalyhub-v2",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "react-router typegen && tsc -b",
    "test": "pnpm run test:unit && pnpm run test:kernel",
    "test:unit": "vitest run",
    "test:kernel": "vitest run --config ./vitest.workers.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:partitions": "node scripts/e2e-partitions.mjs plan",
    "e2e:partitions:check": "node scripts/e2e-partitions.mjs check",
    "e2e:partitions:generate": "node scripts/e2e-partitions.mjs generate",
    "e2e:gate": "node scripts/e2e-gate.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run scheme:check && pnpm run test && pnpm run build && pnpm run test:e2e",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --config build/server/wrangler.json",
    "deploy:production:preflight": "node scripts/deploy-production.mjs --preflight-only",
    "deploy:production:release-check": "node scripts/deploy-production.mjs --release-check-only",
    "deploy:production:verify": "node scripts/deploy-production.mjs --verify-health-only",
    "deploy:production": "node scripts/deploy-production.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "scheme:generate": "node scripts/generate-m3-scheme.mjs",
    "scheme:check": "node scripts/generate-m3-scheme.mjs --check",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "cf-typegen": "wrangler types",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:production:list": "node scripts/production-d1.mjs d1 migrations list dalyhub-v2",
    "db:production:apply": "node scripts/production-d1.mjs d1 migrations apply dalyhub-v2",
    "db:production:export": "node scripts/production-d1.mjs d1 export dalyhub-v2",
    "db:production:backup": "node scripts/backup-worker.mjs trigger",
    "db:production:backup:list": "node scripts/backup-worker.mjs list",
    "backup:provision": "node scripts/backup-worker.mjs provision",
    "backup:secret": "node scripts/backup-worker.mjs secret",
    "backup:deploy": "node scripts/backup-worker.mjs deploy",
    "backup:status": "node scripts/backup-worker.mjs status",
    "backup:verify": "node scripts/backup-worker.mjs verify",
    "identity:report:local": "node scripts/repair-activity-identity.mjs --local",
    "identity:repair:local": "node scripts/repair-activity-identity.mjs --local --apply",
    "identity:report:production": "node scripts/repair-activity-identity.mjs",
    "identity:repair:production": "node scripts/repair-activity-identity.mjs --apply",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "ical.js": "2.2.1",
    "isbot": "5.2.1",
    "jose": "6.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@eslint/js": "10.0.1",
    "@material/material-color-utilities": "0.4.0",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/hast": "3.0.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
